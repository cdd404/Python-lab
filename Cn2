# PROGRAM 2: Transmission of ping messages over a 6-node network and finding the number of packets dropped due to congestion

set ns [new Simulator]

# NAM trace file
set nf [open pg2.nam w]
$ns namtrace-all $nf

# Trace file
set nd [open pg2.tr w]
$ns trace-all $nd

# Finish procedure
proc finish {} {
    global ns nf nd

    $ns flush-trace
    close $nf
    close $nd

    exec nam pg2.nam &
    exit 0
}

# --------------------------------------------------
# Create 6 nodes: n0, n1, n2, n3, n4, n5
# --------------------------------------------------

set n0 [$ns node]
set n1 [$ns node]
set n2 [$ns node]
set n3 [$ns node]
set n4 [$ns node]
set n5 [$ns node]

# --------------------------------------------------
# Create network topology
# n0 is the central node
# --------------------------------------------------

$ns duplex-link $n0 $n1 1Mb 10ms DropTail
$ns duplex-link $n0 $n2 1Mb 10ms DropTail
$ns duplex-link $n0 $n3 10kb 10ms DropTail
$ns duplex-link $n0 $n4 1Mb 10ms DropTail
$ns duplex-link $n0 $n5 1Mb 10ms DropTail

# --------------------------------------------------
# Set queue limits to create congestion
# --------------------------------------------------

$ns queue-limit $n0 $n3 1
$ns queue-limit $n0 $n4 2
$ns queue-limit $n0 $n5 1

# --------------------------------------------------
# Create Ping agents
# --------------------------------------------------

Agent/Ping instproc recv {from rtt} {
    $self instvar node_

    puts "node [$node_ id] received ping answer from \
$from with round-trip-time $rtt ms."
}

set p1 [new Agent/Ping]
set p2 [new Agent/Ping]
set p3 [new Agent/Ping]
set p4 [new Agent/Ping]
set p5 [new Agent/Ping]
set p6 [new Agent/Ping]

# Attach ping agents to nodes
$ns attach-agent $n0 $p1
$ns attach-agent $n1 $p2
$ns attach-agent $n2 $p3
$ns attach-agent $n3 $p4
$ns attach-agent $n4 $p5
$ns attach-agent $n5 $p6

# --------------------------------------------------
# Connect ping agents
# --------------------------------------------------

$ns connect $p1 $p4
$ns connect $p2 $p5
$ns connect $p3 $p6

# --------------------------------------------------
# Generate ping traffic
# --------------------------------------------------

$ns at 0.2 "$p1 send"
$ns at 0.4 "$p2 send"
$ns at 0.6 "$p3 send"
$ns at 0.8 "$p1 send"
$ns at 1.0 "$p2 send"
$ns at 1.2 "$p3 send"
$ns at 1.4 "$p1 send"
$ns at 1.6 "$p2 send"
$ns at 1.8 "$p3 send"

# Finish simulation
$ns at 2.0 "finish"

# Run simulation
$ns run

